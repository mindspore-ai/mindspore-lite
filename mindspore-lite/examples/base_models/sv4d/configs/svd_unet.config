[acl_build_options]
input_format="ND"
# UNetSpatioTemporalConditionModel (SV4D denoiser), 576x1024 -> 4-ch 72x128
# latent, 25 frames, classifier-free guidance batch=2.
#
# sample: [2,25,8,72,128]
#   - dim0 = 2 (uncond + cond, CFG x2 in one forward)
#   - dim1 = 25 frames (SV4D default num_frames)
#   - dim2 = 8 = 4 noise channels + 4 VAE image-latent channels (concat on
#     channel dim by the pipeline; unet.config.in_channels=8)
#   - dim3,4 = latent_h, latent_w = 576/8, 1024/8 = 72, 128
# timestep: [2] (same scalar for both CFG halves)
# encoder_hidden_states: [2,1,1024] (CLIP image_embeds, seq_len=1)
# added_time_ids: [2,3] = (fps-1, motion_bucket_id, noise_aug_strength)
#   encoded by add_time_proj (256-dim sinusoid per id) + add_embedding
#   (projection_class_embeddings_input_dim = 3*256 = 768).
#
# cross_attention_dim=1024, block_out_channels=(320,640,1280,1280),
# addition_time_embed_dim=256, num_attention_heads=(5,10,20,20).
input_shape="sample:2,25,8,72,128;timestep:2;encoder_hidden_states:2,1,1024;added_time_ids:2,3"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
