[acl_build_options]
input_format="ND"
# Vision encoder fixed grid: vision_image_size=896, patch_size=14 -> 64x64=4096 patches, patch_dim=1176.
input_shape="pixel_values:4096,1176"

[acl_init_options]
# force_fp32: the ViT attention scores overflow in fp16 (saturate to +-65504).
ge.exec.precision_mode=force_fp32

[ascend_context]
plugin_custom_ops=All
