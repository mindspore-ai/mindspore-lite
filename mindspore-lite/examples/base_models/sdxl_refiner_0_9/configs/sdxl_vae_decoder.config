[acl_build_options]
input_format="ND"
# AutoencoderKL.decode (SDXL refiner, 4-ch VAE -- architecturally identical to
# the base SDXL VAE): 4-ch latent (1024/8=128) -> 3-ch 1024x1024 image.
input_shape="latents:1,4,128,128"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
