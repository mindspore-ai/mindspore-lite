[acl_build_options]
input_format="ND"
# SDXL refiner UNet2DConditionModel (denoiser), 1024x1024 -> 4-ch 128x128 latent,
# CLIP-G seq=77. Refiner cross_attention_dim=1280 (CLIP-G penultimate only --
# NOT the base's 2048 concat, since the refiner ships text_encoder=None).
# added_cond_kwargs: text_embeds[1,1280] (pooled CLIP-G) + time_ids[1,5]
# = (orig_h, orig_w, crop_top, crop_left, aesthetic_score) -- 5 values, because
# the refiner sets requires_aesthetics_score=True (NOT the base's 6-tuple with
# target_h/target_w). block_out_channels=(320,640,1280,1280).
input_shape="sample:1,4,128,128;timestep:1;encoder_hidden_states:1,77,1280;text_embeds:1,1280;time_ids:1,5"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
