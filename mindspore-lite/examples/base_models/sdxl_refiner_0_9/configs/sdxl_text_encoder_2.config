[acl_build_options]
input_format="ND"
# CLIP-G text encoder 2 (SDXL refiner, with projection): the refiner uses ONLY
# CLIP-G (not the base's CLIP-L+CLIP-G concat). input_ids [1,77] ->
# last_hidden_state [1,77,1280] (penultimate hidden layer) + text_embeds [1,1280]
# (pooled, used as added_cond_kwargs.text_embeds).
input_shape="input_ids:1,77"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
