[acl_build_options]
input_format="ND"
# SDXL UNet2DConditionModel (denoiser), 1024x1024 -> 4-ch 128x128 latent, CLIP seq=77.
# encoder_hidden_states = concat(text_enc1[768] + text_enc2[1280]) = 2048.
# added_cond_kwargs: text_embeds[1,1280] (pooled CLIP-G) + time_ids[1,6]
# (orig_h, orig_w, crop_top, crop_left, target_h, target_w).
# cross_attention_dim=2048, block_out_channels=(320,640,1280,1280).
input_shape="sample:1,4,128,128;timestep:1;encoder_hidden_states:1,77,2048;text_embeds:1,1280;time_ids:1,6"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
