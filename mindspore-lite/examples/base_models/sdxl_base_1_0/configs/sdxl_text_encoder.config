[acl_build_options]
input_format="ND"
# CLIP-L text encoder 1 (SDXL): input_ids [1,77] -> last_hidden_state [1,77,768]
# (penultimate hidden layer, per SDXL encode_prompt convention).
input_shape="input_ids:1,77"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
