[acl_build_options]
input_format="ND"
# Kandinsky-5.0-T2I-Lite text encoder = Qwen2.5-VL-7B-Instruct (last hidden
# state of the LM stack). input_ids[1,512] + attention_mask[1,512]
# -> last_hidden_state[1,512,3584]. The pipeline slices [:, 41:] before feeding
# the DiT; the slice is done in numpy here so the exported graph keeps the full
# sequence (matching HF).
input_shape="input_ids:1,512;attention_mask:1,512"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
