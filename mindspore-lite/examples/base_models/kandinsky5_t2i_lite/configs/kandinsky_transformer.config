[acl_build_options]
input_format="ND"
# Kandinsky-5.0-T2I-Lite transformer (Kandinsky5Transformer3DModel, ~6B DiT),
# 1024x1024 -> latent [1,16,1,128,128] -> patchify (1,2,2) -> 4096 visual tokens.
# model_dim=2560 (20 heads x 128), 2 text + 50 visual blocks, RoPE 3D (32,48,48).
# Qwen text embeds: encoder_hidden_states[1,471,3584] (512 - 41 template tokens).
# CLIP pooled: pooled_projections[1,768] (added to the timestep embed).
input_shape="hidden_states:1,16,1,128,128;encoder_hidden_states:1,471,3584;timestep:1;pooled_projections:1,768;visual_rope_h:64;visual_rope_w:64;text_rope:471"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
