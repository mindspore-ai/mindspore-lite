[acl_build_options]
input_format="ND"
# Vision tower: 1 global 1024x1024 view + n_crops=2 local 768x768 crops.
input_shape="global_image:1,3,1024,1024;crops:2,3,768,768"

[acl_init_options]
# force_fp32: SAM ViT attention scores overflow in fp16 (saturate to +-65504).
ge.exec.precision_mode=force_fp32

[ascend_context]
plugin_custom_ops=All
