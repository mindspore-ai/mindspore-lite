[acl_build_options]
input_format="ND"
# Fixed-shape decode: num_hidden_layers=12, num_key_value_heads=10, head_dim=128, kv_cache_len=2048.
# NOTE: do NOT use force_fp32 (corrupts output); default fp16.
input_shape="input_ids:1,1;attention_mask:1,2048;position_ids:1,1;past_key_values:24,1,10,2048,128;cache_pos:1"

[ascend_context]
plugin_custom_ops=All
