[ascend_context]
plugin_custom_ops=All
model_cache_mode=mem_opt

[ge_session_options]
ge.constLifecycle=session
ge.exec.atomicCleanPolicy=1
ge.event=notify
ge.exec.staticMemoryPolicy=2
ge.exec.precision_mode=force_fp16
ge.externalWeight=2

[ge_graph_options]
ge.inputShape=U292:1,1;U293:1,-1;U294:1,1;U295:36,1,4,-1,128;U296:36,1,4,-1,128
ge.dynamicDims=2176,2176,2176;3328,3328,3328
ge.dynamicNodeType=1
