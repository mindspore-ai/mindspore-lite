[acl_build_options]
input_format="ND"
# CLIP-ViT-H vision model with projection (image_encoder):
# pixel_values [1,3,224,224] -> image_embeds [1,1024] (projection_dim=1024).
# This embeds the conditioning image; it becomes the UNet cross-attention
# encoder_hidden_states (seq_len=1, cross_attention_dim=1024).
input_shape="pixel_values:1,3,224,224"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
