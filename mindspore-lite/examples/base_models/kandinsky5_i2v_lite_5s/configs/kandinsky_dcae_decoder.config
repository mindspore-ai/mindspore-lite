[acl_build_options]
input_format="ND"
# Kandinsky-5.0-I2V-Lite-5s image decoder = FLUX.1-dev AutoencoderKL.decode (8x
# spatial, 16 latent channels). There is NO DCAE in K5 Image Lite (the "DCAE /
# 128x" rumour applies to Sana, not K5). The filename keeps the "dcae_decoder"
# name; the actual graph is AutoencoderKL.decode:
# latents[1,16,128,128] -> image[1,3,1024,1024]. (The source image is VAE-ENCODED
# on CPU in the inference script; only the decoder is exported.)
input_shape="latents:1,16,128,128"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
