[acl_build_options]
input_format="ND"
# Kandinsky-5.0-I2V-Lite-5s transformer (Kandinsky5Transformer3DModel, visual_cond=True).
# 1024x1024 -> latent (128,128); channels-LAST layout. I2I conditioning = concat
# [noise(16), image_latents(16), mask(1)] = 33 ch on-device. Qwen text embeds
# encoder_hidden_states[1,457,3584] (512 - 55 template tokens); CLIP pooled
# pooled_projections[1,768]; RoPE positions visual_rope_h/w[64], text_rope[457].
# Output noise_pred[1,1,128,128,16].
input_shape="noise:1,1,128,128,16;image_latents:1,1,128,128,16;mask:1,1,128,128,1;encoder_hidden_states:1,457,3584;timestep:1;pooled_projections:1,768;visual_rope_h:64;visual_rope_w:64;text_rope:457"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
