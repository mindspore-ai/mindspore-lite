[acl_build_options]
input_format="ND"
# Kandinsky-5.0-I2V-Lite-5s pooled encoder = CLIP text (clip-vit-large-patch14)
# pooler_output. For I2I the CLIP prompt is the plain text prompt (the source
# image does NOT go through CLIP). input_ids[1,77] + attention_mask[1,77]
# -> pooled_embeds[1,768] (added to the timestep embed).
input_shape="input_ids:1,77;attention_mask:1,77"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
