[acl_build_options]
input_format="ND"
# InternVL3.5 LLM prefill (Qwen3 backbone, consumes inputs_embeds).
# seq = num_img_tokens(256) + max_text_len(64) = 320.
# hidden/num_layers/num_kv_heads/head_dim read from checkpoint at export:
#   hidden=1024, num_layers=28, num_kv_heads=8, head_dim=128, KV_CACHE_LEN=1024.
input_shape="inputs_embeds:1,320,1024;attention_mask:1,320;position_ids:1,320"

[acl_init_options]
ge.exec.precision_mode=force_fp32

[ascend_context]
plugin_custom_ops=All
