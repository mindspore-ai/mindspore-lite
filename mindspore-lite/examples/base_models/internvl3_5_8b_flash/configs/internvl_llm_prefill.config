[acl_build_options]
input_format="ND"
# InternVL3.5 LLM prefill (Qwen3 backbone). inputs_embeds[1, seq, hidden] +
# position_ids[1, seq] -> logits + KV. seq = num_img_tokens(256) + max_text_len(64)
# = 320. hidden/num_layers/num_heads are read from the checkpoint at export;
# the values below are 1B estimates (hidden=1024) -- regenerate for other scales.
input_shape="inputs_embeds:1,320,1024;position_ids:1,320"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
