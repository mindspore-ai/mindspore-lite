[acl_build_options]
input_format="ND"
# InternVL3.5 vision encoder (InternViT + mlp1). pixel_values[1,3,448,448]
# -> image_embeds[1,256,llm_hidden]. Image size / num_img_tokens must match the
# export. Shapes below are for the 1B; regenerate for other scales.
input_shape="pixel_values:1,3,448,448"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
