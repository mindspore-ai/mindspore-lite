[acl_build_options]
input_format="ND"
# InternVL3.5 LLM decode (single step, fixed-shape KV cache).
# inputs_embeds[1,1,hidden], position_ids[1,1], cache_position[1],
# past_keys/past_values[num_layers,1,num_kv_heads,max_total_len,head_dim].
# 1B estimates: num_layers=28, num_kv_heads=8, head_dim=64, max_total_len=1024.
# Regenerate for other scales (the export prints the exact shapes).
input_shape="inputs_embeds:1,1,1024;position_ids:1,1;cache_position:1;past_keys:28,1,8,1024,64;past_values:28,1,8,1024,64"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
