[acl_build_options]
input_format="ND"
# FLUX.1 transformer (denoiser), 1024x1024 -> 4096 latent tokens, T5 seq=256.
# inner_dim=3072 (24 heads x 128), 19 double + 38 single blocks.
input_shape="hidden_states:1,4096,64;encoder_hidden_states:1,256,4096;pooled_projections:1,768;timestep:1;guidance:1;img_ids:4096,3;txt_ids:256,3"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
