[acl_build_options]
input_format="ND"
# AutoencoderKLTemporalDecoder.decode (SVD temporal VAE), single-frame chunk:
# 4-ch latent (576/8=72, 1024/8=128) -> 3-ch 576x1024 image.
# Exported with num_frames=1 (the temporal Conv3d reduces to a per-frame conv
# over a 1-frame window). The host decodes each of the 25 frames independently
# via this single-frame graph (matches diffusers decode_chunk_size=1 path).
input_shape="latents:1,4,72,128"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
