[ascend_context]
plugin_custom_ops=All

[ge_session_options]
ge.constLifecycle=session
ge.exec.atomicCleanPolicy=1
ge.event=notify
ge.exec.staticMemoryPolicy=2
ge.exec.precision_mode=force_fp16
ge.externalWeight=2

[ge_graph_options]
# Directory-level conversion leaves the prefix graph dynamic ([1,-1]); fix it at
# 512 here. Must be [ge_graph_options]: [ge_session_options] is not consulted by
# GeDynamicUtils::GetGraphInputShapes and the first predict then fails with
# "Reshape_ReshapeRecoveryPass_0 ... shape input[0] is empty tensor".
ge.inputShape=input_ids:1,512;attention_mask:1,512;position_ids:1,512
