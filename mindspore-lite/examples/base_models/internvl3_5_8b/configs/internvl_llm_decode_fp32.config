[acl_build_options]
input_format="ND"
# InternVL3.5 LLM decode (single step, fixed-shape KV cache).
# past/present_key_cache[num_layers=28,1,num_kv_heads=8,KV_CACHE_LEN=1024,head_dim=128].
input_shape="inputs_embeds:1,1,4096;attention_mask:1,1024;position_ids:1,1;past_key_cache:36,1,8,1024,128;past_value_cache:36,1,8,1024,128"

[acl_init_options]
ge.exec.precision_mode=force_fp32

[ascend_context]
plugin_custom_ops=All
