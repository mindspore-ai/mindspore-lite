[acl_build_options]
input_format="ND"
# FLUX.2 transformer part1 (dev1): 32 single blocks + norm_out + proj_out.
# hidden_mid = [1, 4096+512, 6144] (img+txt concatenated stream from part0).
input_shape="hidden_mid:1,4608,6144;timestep:1;guidance:1;img_ids:4096,4;txt_ids:512,4"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
