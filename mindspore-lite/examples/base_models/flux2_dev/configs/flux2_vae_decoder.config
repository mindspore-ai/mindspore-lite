[acl_build_options]
input_format="ND"
# AutoencoderKLFlux2.decode: 32-ch latent (1024/8=128) -> 3-ch 1024x1024 image.
# (BN denorm + unpatchify done in numpy by the infer script before this decode.)
input_shape="latents:1,32,128,128"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
