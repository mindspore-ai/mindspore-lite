[acl_build_options]
input_format="ND"
# FLUX.2 transformer part0 (dev0): 8 double + 16 single blocks.
# 1024x1024 -> 4096 latent tokens (128ch), Mistral3 seq=512 (15360), 4D RoPE ids.
input_shape="hidden_states:1,4096,128;encoder_hidden_states:1,512,15360;timestep:1;guidance:1;img_ids:4096,4;txt_ids:512,4"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
