[acl_build_options]
input_format="ND"
# OPT prefill: ONNX has 2 inputs (attention_mask is optimized out — full attention).
# inputs_embeds[1,64,2560] + position_ids[1,64] -> logits + present_kv[64,1,32,64,80].
# seq fixed to 64 (32 query embeds + question_len).
input_shape="inputs_embeds:1,64,2560;position_ids:1,64"

[acl_init_options]
ge.exec.precision_mode = force_fp16

[ascend_context]
plugin_custom_ops=All
