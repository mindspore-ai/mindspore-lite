[acl_build_options]
input_format="ND"
# Kandinsky-5.0-I2I-Lite text encoder = Qwen2.5-VL-7B-Instruct. The I2I prompt
# template wraps prompt + a downscaled source image (55 template tokens, vs 41
# for T2I); the [:, 55:] slice is done in numpy at inference, so the exported
# graph keeps the full sequence. input_ids[1,512] + attention_mask[1,512]
# -> last_hidden_state[1,512,3584].
input_shape="input_ids:1,512;attention_mask:1,512"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
