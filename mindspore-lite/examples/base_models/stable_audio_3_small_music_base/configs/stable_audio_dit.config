[acl_build_options]
input_format="ND"
# stable-audio-3-small DiT (denoiser) for 10s @ 32kHz.
# latent_frames = ceil(10 * 32000 / 1024) = 313.
# Inputs:
#   x              [1, 64, 313]        noisy latent
#   t              [1]                 sigma scalar
#   cross_attn_cond[1, 256, 768]       T5 text embeds
#   global_cond    [1, 1536]           (sigma, seconds) packed conditioning
# Output: velocity_pred [1, 64, 313].
# DiT: hidden=1536 (24 heads x 64), depth=24. Attention = PromptFlashAttention
# Custom op (full bidirectional, no mask), BNSD layout.
input_shape="x:1,64,313;t:1;cross_attn_cond:1,256,768;global_cond:1,1536"

[acl_init_options]
ge.exec.precision_mode=force_fp16

[ascend_context]
plugin_custom_ops=All
