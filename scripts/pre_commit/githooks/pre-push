function check_tool_version() {
    local tool_name="$1"
    local expected_version="$2"
    log_debug "Checking ${tool_name} version..."
    if ! command -v "$tool_name" &> /dev/null; then
        log_warning "[WARNING] ${tool_name} is not installed"
        log_info "  To install, run the following commands in the mindspore-lite/ directory:"
        log_info "  cd scripts/pre_commit"
        log_info "  bash install_tools.sh"
        return 1
    fi
    local actual_version=""
    case "$tool_name" in
        "clang-format")
            actual_version=$("$tool_name" --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            ;;
        "cmakelint")
            actual_version=$("$tool_name" --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            ;;
        "codespell")
            actual_version=$("$tool_name" --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            ;;
        "cpplint")
            actual_version=$("$tool_name" --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            ;;
        "pylint")
            actual_version=$(pip show pylint 2>/dev/null | grep "Version:" | awk '{print $2}')
            if [ -z "$actual_version" ]; then
                actual_version=$("$tool_name" --version 2>&1 | head -1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            fi
            ;;
        "lizard")
            actual_version=$("$tool_name" --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            ;;
        *)
            log_warning "[WARNING] Unknown tool: ${tool_name}"
            return 1
            ;;
    esac
    if [ -z "$actual_version" ]; then
        log_warning "[WARNING] Cannot extract version for ${tool_name}"
        log_info "  Please reinstall the tool using:"
        log_info "  cd scripts/pre_commit"
        log_info "  bash install_tools.sh"
        return 1
    fi
    log_debug "  Expected version: ${expected_version}"
    log_debug "  Actual version: ${actual_version}"
    if [ "$actual_version" != "$expected_version" ]; then
        log_warning "[WARNING] ${tool_name} version mismatch!"
        log_warning "  Expected: ${expected_version}"
        log_warning "  Actual: ${actual_version}"
        log_warning "  Due to version mismatch with the CI pipeline, the check results may differ."
        log_info "  Please reinstall the correct version by running the following commands in the mindspore-lite/ directory:"
        log_info "  cd scripts/pre_commit"
        log_info "  bash install_tools.sh"
        return 2
    fi
    log_success "[OK] ${tool_name} version ${actual_version} matches expected version ${expected_version}"
    return 0
}

function check_clang_format_version() {
    local expected_version="${CLANG_FORMAT_VERSION}"
    if [ "$(uname -s)" == "Darwin" ] && [ "$(uname -m)" == "arm64" ]; then
        expected_version="${CLANG_FORMAT_VERSION_ARM64_MAC}"
        log_debug "Detected Darwin arm64 system, using clang-format version: ${expected_version}"
    fi
    check_tool_version "clang-format" "$expected_version"
    return $?
}

function check_all_tool_versions() {
    log_step "Checking tool versions..."
    local all_ok=0
    local warnings=0
    local original_dir=$(pwd)
    if [ -d "${REPO_HOME}" ]; then
        cd "${REPO_HOME}" 2>/dev/null || cd / 2>/dev/null || true
    fi
    if ! check_clang_format_version; then
        all_ok=1
        warnings=$((warnings + 1))
    fi
    if ! check_tool_version "cmakelint" "${CMAKELINT_VERSION}"; then
        all_ok=1
        warnings=$((warnings + 1))
    fi
    if ! check_tool_version "codespell" "${CODESPELL_VERSION}"; then
        all_ok=1
        warnings=$((warnings + 1))
    fi
    if ! check_tool_version "cpplint" "${CPPLINT_VERSION}"; then
        all_ok=1
        warnings=$((warnings + 1))
    fi
    # shellcheck disable=SC2153
    if ! check_tool_version "pylint" "${PYLINT_VERSION}"; then
        all_ok=1
        warnings=$((warnings + 1))
    fi
    if ! check_tool_version "lizard" "${LIZARD_VERSION}"; then
        all_ok=1
        warnings=$((warnings + 1))
    fi
    cd "${original_dir}" 2>/dev/null || cd ~ 2>/dev/null || true
    if [ $warnings -eq 0 ]; then
        log_success "All tool versions are correct!"
    else
        log_warning "Found $warnings tool version issue(s)."
        log_info "  Note: Due to version mismatches, the check results may differ from the CI pipeline."
        log_info "  For consistent results, please ensure all tools are installed with the correct versions."
    fi
    return $all_ok
}

convert_path_for_local() {
    local line="$1"
    if [[ "$line" =~ ^[[:space:]]*# ]]; then
        echo "$line"
        return
    fi
    if [[ -z "$line" ]] || [[ "$line" =~ ^[[:space:]]*$ ]]; then
        echo ""
        return
    fi
    if [[ "$line" =~ ^\"([^\"]+)\"[[:space:]]+\"([^\"]+)\" ]]; then
        local original_path="${BASH_REMATCH[1]}"
        local rule="${BASH_REMATCH[2]}"
        local converted_path="$original_path"
        if [[ -n "$original_path" ]] && [[ "$original_path" =~ / ]]; then
            converted_path="${original_path#*/}"
        fi
        if [[ "$original_path" =~ /$ ]] && [[ ! "$converted_path" =~ /$ ]] && [[ -n "$converted_path" ]]; then
            converted_path="$converted_path/"
        fi
        echo "\"$converted_path\" \"$rule\""
        return
    fi
    if [[ "$line" =~ ^([^:]+):(.+)$ ]]; then
        local file_path="${BASH_REMATCH[1]}"
        local function_name="${BASH_REMATCH[2]}"
        local converted_path="$file_path"
        if [[ -n "$file_path" ]] && [[ "$file_path" =~ / ]]; then
            converted_path="${file_path#*/}"
        fi
        echo "$converted_path:$function_name"
        return
    fi
    echo "$line"
}

create_converted_filter_file() {
    local source_file="$1"
    local dest_file="$2"
    if [[ ! -f "$source_file" ]]; then
        return 1
    fi
    :> "$dest_file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        local converted_line=$(convert_path_for_local "$line")
        echo "$converted_line" >> "$dest_file"
    done < "$source_file"
    return 0
}

