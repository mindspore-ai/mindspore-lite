            if [ -s "$compiled_rules" ]; then
                grep -v -f "$compiled_rules" "${pylint_path}/pylint_original.log" > "${pylint_path}/pylint.log" 2>/dev/null
            else
                cp "${pylint_path}/pylint_original.log" "${pylint_path}/pylint.log"
            fi
            rm -f "$compiled_rules"
        else
            cp "${pylint_path}/pylint_original.log" "${pylint_path}/pylint.log"
        fi
        rm -f "$converted_filter"
    else
        cp "${pylint_path}/pylint_original.log" "${pylint_path}/pylint.log"
    fi
    local error_number=0
    local error_file="${pylint_path}/pylint.log"
    if [ -f "$error_file" ]; then
        error_number=$(grep -E '^[^:]+:[0-9]+:' "$error_file" 2>/dev/null | wc -l | tr -d ' ')
    fi
    error_number=${error_number:-0}
    if [ "$error_number" != 0 ]; then
