        done < <(grep -E '^[^:]+:[0-9]+:' "$error_file" 2>/dev/null | head -20)
        if [ "$error_number" -gt 20 ]; then
            log_error "  ... and $((error_number - 20)) more issues"
        fi
    fi
    DP_ASSERT_EQUAL "${error_number}" "0" "Pylint scanning" "pylint"
    local total_duration=$(( $(date +%s) - total_start_time ))
