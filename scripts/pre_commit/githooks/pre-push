        return 1
    }
    : >"${pylint_path}"/pylint_original.log
    local file_args=()
    local missing_files=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        if [ -f "${workspace}/${line}" ]; then
            file_args+=("${workspace}/${line}")
        else
            if [ -f "${REPO_HOME}/${line}" ]; then
                log_warning "File ${line} not found in workspace, using original path"
                file_args+=("${REPO_HOME}/${line}")
                missing_files+=("${line}")
