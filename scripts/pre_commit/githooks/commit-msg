# commit-msg hook: enforce commit message conventions.
# Rejects any commit whose message contains a Co-Authored-By trailer.

readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

msg_file="$1"
if [ ! -f "$msg_file" ]; then
    exit 0
fi

# Match Co-Authored-By in any case, allowing leading whitespace and the standard
# "Name <email>" payload. Also catches the "Generated with" trailer that some
# AI tools append alongside.
if grep -iE '^[[:space:]]*co-authored-by:' "$msg_file" >/dev/null; then
    echo -e "${RED}[commit-msg]${NC} Rejected: commit message contains a Co-Authored-By trailer."
    echo -e "${YELLOW}This repo does not accept Co-Authored-By lines (no AI/bot attribution).${NC}"
    echo -e "${YELLOW}Strip the trailer and re-commit. See CLAUDE.md 提交规范 for details.${NC}"
    exit 1
fi

exit 0
